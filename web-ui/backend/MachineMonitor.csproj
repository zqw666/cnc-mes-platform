<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>bin/Any CPU/Debug/net472/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="DataCommonOperate">
      <HintPath>..\..\CommonOperateDll\CommonOperateDll\DataCommonOperate\bin\Debug\DataCommonOperate.dll</HintPath>
    </Reference>
    <Reference Include="MySql.Data">
      <HintPath>..\lib\MySql.Data.dll</HintPath>
    </Reference>
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <!-- 直接引用 MySql.Data 8.3.0 (支持 MySQL 8.x utf8mb3) -->
  </ItemGroup>
  <!-- 自动复制config.json到输出目录 -->
  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="node-types.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!-- 排除所有子程序目录，避免编译冲突 -->
  <ItemGroup>
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
    <Compile Remove="subs\**" />
  </ItemGroup>
  <!-- 构建后自动复制前端文件到输出目录 -->
  <Target Name="CopyFrontend" AfterTargets="Build">
    <ItemGroup>
      <!-- _proto 是选型阶段的弃用原型（含 amis 版），不进部署包，避免误投放和第三方许可证问题 -->
      <FrontendFiles Include="..\frontend\**\*.*" Exclude="..\frontend\**\*.bak;..\frontend\**\*.bak-*;..\frontend\**\obj\**;..\frontend\**\bin\**;..\frontend\**\_proto\**" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendFiles)" DestinationFiles="@(FrontendFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
